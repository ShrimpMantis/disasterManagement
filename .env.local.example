# Firebase client config (web SDK)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps (Maps JavaScript API + Directions API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional Cloud Map ID for Advanced Markers (defaults to DEMO_MAP_ID)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Firebase Admin SDK service account (from firebasesdksecret.json)
# Prefer FIREBASE_ADMIN_* (matches App Hosting Secret Manager / apphosting.yaml).
# Legacy FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY still work locally.
# Put the private key on one line with \n escapes, e.g.:
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_TYPE=
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# Legacy aliases (optional if FIREBASE_ADMIN_* are set)
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=
FIREBASE_TOKEN_URI=
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=
FIREBASE_CLIENT_X509_CERT_URL=
# Comma-separated emails treated as admin (warehouse XLSX upload, etc.)
# Also honors Firebase custom claim: role = "admin"
NEXT_PUBLIC_ADMIN_EMAILS=

# Deployment operational mode (build-time; inlined into the client bundle)
# CROWDSOURCED  — public community contribution (SOS/requests, fleet +, verify, open pledging)
# ADMIN_SOURCED — verified agency workflow (public writes hidden; NGO pledging only)
NEXT_PUBLIC_OPERATIONAL_MODE=CROWDSOURCED

# Seed callable helpers (frontend -> backend functions)
# Optional when backend functions are deployed outside the default region.
SEED_FUNCTIONS_REGION=asia-south1
# Optional full override, e.g. https://asia-south1-your-project.cloudfunctions.net
SEED_FUNCTIONS_BASE_URL=
# Optional bootstrap secret accepted by backend seed callables.
SEED_SECRET=
